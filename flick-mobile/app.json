{
  "expo": {
    "name": "Flick",
    "slug": "flick-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.flickit.app",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.dev.flickit.app"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dev.flickit.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-status-bar",
      "expo-sharing",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Flick opens your photos so you can send the ones you pick to your other devices.",
          "cameraPermission": "Flick uses the camera when you tap Take photo, so you can send the picture to your other devices.",
          "microphonePermission": false
        }
      ],
      "@bacons/apple-targets"
    ],
    "scheme": "flick"
  }
}
