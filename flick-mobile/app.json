{
  "expo": {
    "name": "eqlShare",
    "slug": "flick-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.eqlshare.app",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.eqlshare.app"
        ]
      },
      "infoPlist": {
        "NSSupportsLiveActivities": true
      },
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F5B83D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.eqlshare.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "themeColor": "#F5B83D"
    },
    "plugins": [
      "./plugins/withAndroidGradle9",
      "expo-font",
      "expo-status-bar",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3F2EF",
          "image": "./assets/icon-rounded-splash.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/icon-rounded-splash.png"
          }
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "eqlShare opens your photos so you can send the ones you pick to your other devices.",
          "cameraPermission": "eqlShare uses the camera when you tap Take photo, so you can send the picture to your other devices.",
          "microphonePermission": false
        }
      ],
      "@bacons/apple-targets",
      [
        "expo-share-intent",
        {
          "disableIOS": true,
          "androidIntentFilters": [
            "text/*",
            "*/*"
          ],
          "androidMultiIntentFilters": [
            "*/*"
          ],
          "androidMainActivityAttributes": {
            "android:launchMode": "singleTask"
          }
        }
      ]
    ],
    "scheme": [
      "eqlshare",
      "flick"
    ]
  }
}
