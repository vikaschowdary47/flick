{
  "expo": {
    "name": "eqlShare",
    "slug": "flick-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.flickit.app",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.dev.flickit.app"
        ]
      },
      "infoPlist": {
        "NSSupportsLiveActivities": true
      },
      "usesAppleSignIn": true
    },
    "notification": {
      "icon": "./assets/notification-icon.png",
      "color": "#F5B83D"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F5B83D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dev.flickit.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "themeColor": "#F5B83D"
    },
    "plugins": [
      "expo-font",
      "expo-status-bar",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF8EE",
          "image": "./assets/splash-icon.png",
          "dark": {
            "backgroundColor": "#1F2937",
            "image": "./assets/splash-icon-dark.png"
          },
          "resizeMode": "contain"
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
        "photosPermission": "eqlShare opens your photos so you can send the ones you pick to your other devices.",
        "cameraPermission": "eqlShare uses the camera when you tap Take photo, so you can send the picture to your other devices.",
          "microphonePermission": false
        }
      ],
      "@bacons/apple-targets"
    ],
    "scheme": ["eqlshare", "flick"]
  }
}
