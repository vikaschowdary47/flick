{
  "name": "flick-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "npm run build && electron .",
    "test": "npm run lint && npm run typecheck",
    "preview": "electron-vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "package:mac": "npm run build && node scripts/package-mac.mjs",
    "package:win": "npm run build && electron-builder --config electron-builder.win.json --win nsis --x64 --publish never",
    "icon:win": "node scripts/generate-windows-icon.mjs",
    "generate:icons": "node scripts/generate-icons.mjs",
    "test:windows": "node --experimental-strip-types --test tests/windows-behavior.test.mjs"
  },
  "dependencies": {
    "@fontsource/nunito": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "framer-motion": "^14.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^4.0.0",
    "eslint": "^10.13.0",
    "globals": "^16.3.0",
    "sharp": "^0.35.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0",
    "vite": "^7.0.0"
  },
  "description": "eqlDrop file and clipboard sharing desktop tray app",
  "author": "eqlDrop"
}
