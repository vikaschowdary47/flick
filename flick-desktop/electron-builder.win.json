{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "dev.flickit.desktop",
  "productName": "eqlShare",
  "asar": true,
  "directories": {
    "output": "dist/windows",
    "buildResources": "build"
  },
  "files": [
    "out/**/*",
    "package.json"
  ],
  "protocols": [
    {
      "name": "eqlShare Authentication",
      "schemes": [
        "eqlshare",
        "flick"
      ]
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "build/icon.ico",
    "executableName": "eqlShare"
  },
  "nsis": {
    "artifactName": "eqlShare-Setup.exe",
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": false,
    "createStartMenuShortcut": true,
    "shortcutName": "eqlShare",
    "runAfterFinish": true,
    "deleteAppDataOnUninstall": false
  },
  "publish": null,
  "extraResources": [
    {
      "from": "build/icon.ico",
      "to": "icon.ico"
    },
    {
      "from": "build/tray-template.png",
      "to": "tray-template.png"
    },
    {
      "from": "build/tray-template-dot.png",
      "to": "tray-template-dot.png"
    },
    {
      "from": "build/tray-windows-light.png",
      "to": "tray-windows-light.png"
    },
    {
      "from": "build/tray-windows-dark.png",
      "to": "tray-windows-dark.png"
    }
  ],
  "electronLanguages": [
    "en-US"
  ],
  "compression": "maximum"
}
